// Every key a theme file takes, with egui's stock value. Generated by `cargo xtask docs`;
// don't edit. Copy a line into crates/launcher/theme.kdl to change it.
//
// Top-level keys apply to both themes; `dark { }` and `light { }` hold each theme's visuals and
// the other keys whose stock values differ, and apply after the top level.
//
// Colours are "#rrggbb" or "#rrggbbaa"; four plain numbers are egui's premultiplied form
// (some stock colours are additive and have no other).
// A struct takes a block, name=value pairs, its values in field order, or (when its fields are
// all numbers) one number for all of them: `corner_radius 4`.
//
// `extras` are Launcher's own. Unless set, accent follows visuals.selection.stroke, label_gap
// follows spacing.item_spacing.x and step_row_height follows spacing.interact_size.y.

override_text_style #null
override_font_id #null
override_text_valign "Center"
text_styles {
    Small size=9.0 family="Proportional"
    Body size=13.0 family="Proportional"
    Monospace size=13.0 family="Monospace"
    Button size=13.0 family="Proportional"
    Heading size=18.0 family="Proportional"
}
drag_value_text_style "Button"
wrap_mode #null
spacing {
    item_spacing x=8.0 y=3.0
    window_margin 6
    button_padding x=4.0 y=1.0
    menu_margin 6
    indent 18.0
    interact_size x=40.0 y=18.0
    slider_width 100.0
    slider_rail_height 8.0
    combo_width 100.0
    text_edit_width 280.0
    extra_text_line_spacing 0.0
    icon_width 14.0
    icon_width_inner 8.0
    icon_spacing 4.0
    default_area_size x=600.0 y=400.0
    tooltip_width 500.0
    menu_width 400.0
    menu_spacing 2.0
    indent_ends_with_horizontal_line #false
    combo_height 200.0
    scroll {
        floating #true
        content_margin 0
        bar_width 10.0
        handle_min_length 12.0
        bar_inner_margin 4.0
        bar_outer_margin 0.0
        floating_width 2.0
        floating_allocated_width 0.0
        foreground_color #true
        dormant_background_opacity 0.0
        active_background_opacity 0.4
        interact_background_opacity 0.7
        dormant_handle_opacity 0.0
        active_handle_opacity 0.6
        interact_handle_opacity 1.0
        fade strength=0.5 size=20.0
    }
}
interaction {
    interact_radius 5.0
    resize_grab_radius_side 3.0
    resize_grab_radius_corner 10.0
    show_tooltips_only_when_still #true
    tooltip_delay 0.5
    tooltip_grace_time 0.2
    selectable_labels #true
    multi_widget_text_select #true
}
animation_time 0.2
compact_menu_style #true
explanation_tooltips #false
url_in_tooltip #false
always_scroll_the_only_direction #false
scroll_animation {
    points_per_second 1000.0
    duration min=0.1 max=0.3
}
extras {
    margin 16.0
    gap 8.0
    gap_small 4.0
    label_gap 8.0
    group_padding 10.0
    callout_padding 12.0
    step_row_height 18.0
    status_icon_size 14.0
    outline_width 2.0
}

// Nudges per font face (top level only), by the face's file: the built-in Inter-Regular.ttf (text)
// and JetBrainsMonoNL-Regular.ttf (monospace); the text fallbacks segoeui.ttf (Windows), SFNS.ttf
// or Helvetica.ttc (macOS); or egui's own Ubuntu-Light, Hack, NotoEmoji-Regular, emoji-icon-font.
// Faces this OS doesn't load are skipped, so one file serves both. y_offset_factor moves glyphs
// down by that share of the size.
fonts {
    Inter-Regular.ttf {
        scale 1.0
        y_offset_factor 0.0
        y_offset 0.0
        hinting #null
        hinting_target {
            Smooth light=#false symmetric_rendering=#true preserve_linear_metrics=#true
        }
        subpixel_binning #null
        thin_space_width 0.5
        tab_size 4.0
    }
}

dark {
    visuals {
        dark_mode #true
        text_options {
            max_texture_side 2048
            color_transfer_function "TwoCoverageMinusCoverageSq"
            font_hinting #true
            subpixel_binning #true
        }
        override_text_color #null
        weak_text_alpha 0.6
        weak_text_color #null
        widgets {
            noninteractive {
                bg_fill "#1b1b1b"
                weak_bg_fill "#1b1b1b"
                bg_stroke width=1.0 color="#3c3c3c"
                corner_radius 2
                fg_stroke width=1.0 color="#8c8c8c"
                expansion 0.0
            }
            inactive {
                bg_fill "#3c3c3c"
                weak_bg_fill "#3c3c3c"
                bg_stroke width=0.0 color="#00000000"
                corner_radius 2
                fg_stroke width=1.0 color="#b4b4b4"
                expansion 0.0
            }
            hovered {
                bg_fill "#464646"
                weak_bg_fill "#464646"
                bg_stroke width=1.0 color="#969696"
                corner_radius 3
                fg_stroke width=1.5 color="#f0f0f0"
                expansion 0.0
            }
            active {
                bg_fill "#373737"
                weak_bg_fill "#373737"
                bg_stroke width=1.0 color="#ffffff"
                corner_radius 2
                fg_stroke width=2.0 color="#ffffff"
                expansion 0.0
            }
            open {
                bg_fill "#1b1b1b"
                weak_bg_fill "#2d2d2d"
                bg_stroke width=1.0 color="#3c3c3c"
                corner_radius 2
                fg_stroke width=1.0 color="#d2d2d2"
                expansion 0.0
            }
        }
        selection {
            bg_fill "#005c80"
            stroke width=1.0 color="#c0deff"
        }
        ime_composition {
            active_underline_stroke width=2.0 color="#c0deff"
            inactive_underline_stroke width=2.0 color="#bfddff80"
            legacy_visuals #false
        }
        hyperlink_color "#5aaaff"
        faint_bg_color 5 5 5 0
        extreme_bg_color "#0a0a0a"
        text_edit_bg_color #null
        code_bg_color "#404040"
        warn_fg_color "#ff8f00"
        error_fg_color "#ff0000"
        window_corner_radius 6
        window_shadow {
            offset 10 20
            blur 15
            spread 0
            color "#00000060"
        }
        window_fill "#1b1b1b"
        window_stroke width=1.0 color="#3c3c3c"
        window_highlight_topmost #true
        menu_corner_radius 6
        panel_fill "#1b1b1b"
        popup_shadow {
            offset 6 10
            blur 8
            spread 0
            color "#00000060"
        }
        resize_corner_size 12.0
        text_cursor {
            stroke width=2.0 color="#c0deff"
            preview #false
            blink #true
            on_duration 0.5
            off_duration 0.5
        }
        clip_rect_margin 0.0
        button_frame #true
        collapsing_header_frame #false
        indent_has_left_vline #true
        striped #false
        slider_trailing_fill #false
        handle_shape {
            Rect aspect_ratio=0.75
        }
        interact_cursor #null
        image_loading_spinners #true
        numeric_color_space "GammaByte"
        disabled_alpha 0.5
    }
    extras accent="#c0deff" success="#66cc80"
}

light {
    visuals {
        dark_mode #false
        text_options {
            max_texture_side 2048
            color_transfer_function "Off"
            font_hinting #true
            subpixel_binning #true
        }
        override_text_color #null
        weak_text_alpha 0.6
        weak_text_color #null
        widgets {
            noninteractive {
                bg_fill "#f8f8f8"
                weak_bg_fill "#f8f8f8"
                bg_stroke width=1.0 color="#bebebe"
                corner_radius 2
                fg_stroke width=1.0 color="#505050"
                expansion 0.0
            }
            inactive {
                bg_fill "#e6e6e6"
                weak_bg_fill "#e6e6e6"
                bg_stroke width=0.0 color="#00000000"
                corner_radius 2
                fg_stroke width=1.0 color="#3c3c3c"
                expansion 0.0
            }
            hovered {
                bg_fill "#dcdcdc"
                weak_bg_fill "#dcdcdc"
                bg_stroke width=1.0 color="#696969"
                corner_radius 3
                fg_stroke width=1.5 color="#000000"
                expansion 0.0
            }
            active {
                bg_fill "#a5a5a5"
                weak_bg_fill "#a5a5a5"
                bg_stroke width=1.0 color="#000000"
                corner_radius 2
                fg_stroke width=2.0 color="#000000"
                expansion 0.0
            }
            open {
                bg_fill "#dcdcdc"
                weak_bg_fill "#dcdcdc"
                bg_stroke width=1.0 color="#a0a0a0"
                corner_radius 2
                fg_stroke width=1.0 color="#000000"
                expansion 0.0
            }
        }
        selection {
            bg_fill "#90d1ff"
            stroke width=1.0 color="#00537d"
        }
        ime_composition {
            active_underline_stroke width=2.0 color="#00537d"
            inactive_underline_stroke width=2.0 color="#00547e80"
            legacy_visuals #false
        }
        hyperlink_color "#009bff"
        faint_bg_color 5 5 5 0
        extreme_bg_color "#ffffff"
        text_edit_bg_color #null
        code_bg_color "#e6e6e6"
        warn_fg_color "#ff6400"
        error_fg_color "#ff0000"
        window_corner_radius 6
        window_shadow {
            offset 10 20
            blur 15
            spread 0
            color "#00000019"
        }
        window_fill "#f8f8f8"
        window_stroke width=1.0 color="#bebebe"
        window_highlight_topmost #true
        menu_corner_radius 6
        panel_fill "#f8f8f8"
        popup_shadow {
            offset 6 10
            blur 8
            spread 0
            color "#00000019"
        }
        resize_corner_size 12.0
        text_cursor {
            stroke width=2.0 color="#00537d"
            preview #false
            blink #true
            on_duration 0.5
            off_duration 0.5
        }
        clip_rect_margin 0.0
        button_frame #true
        collapsing_header_frame #false
        indent_has_left_vline #true
        striped #false
        slider_trailing_fill #false
        handle_shape {
            Rect aspect_ratio=0.75
        }
        interact_cursor #null
        image_loading_spinners #true
        numeric_color_space "GammaByte"
        disabled_alpha 0.5
    }
    extras accent="#00537d" success="#1a8c40"
}
