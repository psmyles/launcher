// Build a .NET solution from any branch: pick the branch, update it, build Debug or Release and
// maybe run the tests. Put this tool in the repository's root folder.
tool "Build {branch}" format=2 requires="0.2" os="windows"

window {
    choice "branch" label="Branch" {
        list-from "git.branches" folder="."
    }
    // Debug or Release.
    choice "mode" label="Configuration" show-as="buttons" {
        option "Debug"
        option "Release"
    }
    tick-box "verbose" label="Verbose"
    tick-box "tests" label="Run the tests" starts=#true
    button "build" label="Build"
}

steps "build" {
    git.fetch "fetch"
    git.switch-branch "switch" branch="{branch}"
    git.pull "pull"
    dotnet.build "compile" configuration="{mode}"
    dotnet.test "test" configuration="{mode}" if="values.tests"
}
