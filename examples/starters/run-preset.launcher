tool "Run an optimization preset" format=2 requires="0.2"

example name="Run an optimization preset" about="Run a 3D Review optimization preset on every FBX model in a folder, then show where the results went." suggest="review3d"

window {
    file "preset" label="Preset" extensions="json" required=#true must-exist=#true
    folder "models" label="Models" required=#true must-exist=#true
    folder "out" label="Save to" required=#true
    button "start" label="Run"
}

steps "start" {
    review3d.run-preset "run" preset="{preset}" models="{models}" save-to="{out}"
    files.show-in-folder "show" path="{out}"
}
